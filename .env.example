# Langrow 환경변수 예시. `.env.local`로 복사해 값을 채운다. .env.local은 커밋하지 않는다 (.gitignore의 .env*)

# Supabase: `npx supabase start` 뒤 `npx supabase status`에 나오는 로컬 값으로 채운다
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic: 운영과 다른 로컬용 키를 쓰고 지출 한도를 건다
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# scripts/metrics-report 전용: 지표에서 뺄 운영·테스트 계정 user id (쉼표 구분)
METRICS_EXCLUDED_USER_IDS=
